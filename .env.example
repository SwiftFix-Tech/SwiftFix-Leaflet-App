# Public browser key. Restrict it to your Vercel/custom-domain origins.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional public HTTPS static road directory (manifest.json lives here).
# Leave empty ONLY if the complete generated dataset is deployed in public/roads.
# Needed when the national dataset exceeds the app deployment's asset budget.
# This is not a database; no upload credentials belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_ROADS_BASE_URL=
